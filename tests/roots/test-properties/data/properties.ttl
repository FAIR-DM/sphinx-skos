@base <https://example.org/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://example.org/terms/> .

<https://example.org/agents/maker> a foaf:Organization ;
    foaf:name "Maker Org"@en .

<prop> a skos:ConceptScheme ;
    skos:prefLabel "Properties"@en ;
    dcterms:title "Properties vocabulary"@en ;
    dcterms:description "Describes the properties."@en ;
    dcterms:creator <https://example.org/agents/maker> ;
    dcterms:publisher <https://example.org/agents/unnamed> ;
    dcterms:contributor [ a foaf:Person ; foaf:name "Ada Example" ] ,
        [ a foaf:Person ; foaf:name "Bea Example" ] ,
        [ a foaf:Person ; foaf:name "Cy Example" ] ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "All rights reversed."@en ;
    dcterms:created "2024-01-02"^^xsd:date ;
    dcterms:issued "2024-02-03"^^xsd:date ;
    dcterms:modified "2024-05-01"^^xsd:date ;
    dcterms:identifier "PROP-1" ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:source <https://example.org/sources/book> ;
    dcterms:bibliographicCitation "Example, A. (2024). Properties."@en ;
    owl:versionInfo "1.2.0" ;
    rdfs:seeAlso <https://example.org/elsewhere> ;
    ex:custom <https://example.org/custom-target>, "custom text"@de, 42 ;
    <https://unprefixed.example/predicate> "unprefixed value" ;
    skos:hasTopConcept <prop/item> .

<prop/item> a skos:Concept ;
    skos:prefLabel "Item"@en ;
    skos:hiddenLabel "secretword"@en ;
    skos:inScheme <prop> ;
    skos:topConceptOf <prop> ;
    skos:scopeNote "Use for items."@en ;
    skos:note "A note."@en ;
    skos:example "An example."@en ;
    skos:historyNote "Added in 2024."@en ;
    skos:editorialNote "Check wording."@en ;
    skos:changeNote "Renamed."@en ;
    skos:broaderTransitive <prop/other> ;
    ex:part [ ex:nested [ ex:deepest "deep value" ; skos:hiddenLabel "nestedsecret" ] ] .

<prop/other> a skos:Concept ;
    skos:prefLabel "Other"@en ;
    skos:inScheme <prop> .

<prop/group> a skos:Collection ;
    skos:prefLabel "Group"@en ;
    skos:notation "G1" ;
    dcterms:creator <https://example.org/agents/maker> ;
    skos:member <prop/item> ;
    ex:custom "on a collection" .

@prefix : <https://example.org/vocab/third/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

: a skos:ConceptScheme ;
    skos:prefLabel "The third scheme"@en .

:thing a skos:Concept ;
    skos:inScheme : ;
    skos:prefLabel "A third thing"@en .

:kinds a skos:OrderedCollection ;
    skos:prefLabel "third kinds"@en ;
    skos:memberList ( :thing ) .
